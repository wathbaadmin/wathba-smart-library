@echo off
chcp 65001 > nul
title مكتبة وثبة الذكية - Wathba Smart Library
echo ========================================================
echo       جارٍ تشغيل خادم مكتبة وثبة الذكية...
echo ========================================================
echo لا تغلق هذه النافذة السوداء أثناء استخدام الموقع!
echo سيتم فتح المتصفح تلقائياً خلال لحظات...
echo.
cd /d "%~dp0"
call npm run dev
if errorlevel 1 (
    echo.
    echo ========================================================
    echo تنبيه: حدث خطأ أثناء التشغيل. جارٍ تثبيت الحزم للتأكد...
    echo ========================================================
    call npm install
    call npm run dev
)
pause
