# ========================================================================
# إعدادات اتصال قاعدة البيانات السحابية المركزية لمكتبة مداد (Supabase)
# ========================================================================

# رابط مشروع Supabase الخاص بك
# مثال: https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# مفتاح الوصول العام (anon public key)
# يبدأ بـ eyJhbGciOi... تجده في لوحة تحكم Supabase تحت Project Settings > API
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# وضع التشغيل المركزي:
# 'supabase' للربط السحابي المركزي التام والمزامنة بين جميع الأجهزة والموقع المنشور
# 'local' للتشغيل المحلي غير المتصل
VITE_STORAGE_MODE=supabase

# المنطقة الزمنية المعتمدة
VITE_TIMEZONE=Asia/Riyadh
